generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PERSONEL
}

enum AssetType {
  COMPUTER
  SERVER
  MONITOR
  OTHER
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  FAULTY
  RETIRED
}

enum AssetAction {
  CREATED
  UPDATED
  ASSIGNED
  RETURNED
  FAULT_REPORTED
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  assets    Asset[]
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         Role       @default(PERSONEL)
  isActive     Boolean    @default(true)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignments Assignment[] @relation("Assignee")
  assignedBy  Assignment[] @relation("Assigner")
  logs        AssetLog[]

  @@index([departmentId])
  @@index([role])
}

model Asset {
  id                String      @id @default(cuid())
  brand             String
  model             String
  serialNumber      String      @unique
  type              AssetType
  purchaseDate      DateTime    @db.Date
  warrantyExpiresAt DateTime?   @db.Date
  status            AssetStatus @default(IN_STOCK)
  qrCode            String      @unique
  notes             String?
  departmentId      String
  department        Department  @relation(fields: [departmentId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  assignments Assignment[]
  logs        AssetLog[]

  @@index([status])
  @@index([departmentId])
  @@index([type])
}

/// Açık zimmet tekilliği, migrasyondaki Assignment_one_open_per_asset kısmi indeksi ile tutulur.
model Assignment {
  id           String    @id @default(cuid())
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("Assignee", fields: [userId], references: [id])
  assignedById String
  assignedBy   User      @relation("Assigner", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())
  returnedAt   DateTime?
  note         String?

  @@index([assetId, returnedAt])
  @@index([userId, returnedAt])
}

model AssetLog {
  id         String       @id @default(cuid())
  assetId    String
  asset      Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id])
  action     AssetAction
  fromStatus AssetStatus?
  toStatus   AssetStatus?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([assetId, createdAt])
}
